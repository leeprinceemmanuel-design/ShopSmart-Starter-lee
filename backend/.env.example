DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# AI provider (Google Gemini). Get a key at https://aistudio.google.com/apikey
# Put the real key only in backend/.env. Never commit it or use it in frontend code.
# With no key, the assistant still works using its rule-based answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=8000
