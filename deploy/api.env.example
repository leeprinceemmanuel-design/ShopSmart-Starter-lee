# File: deploy/api.env.example
# TEMPLATE ONLY. The real file is /etc/shopsmart/api.env on the EC2 server.
# Never commit the real file, never paste it in chat, never show it in a screenshot.

# Server-only secret. PostgreSQL runs on the same EC2 instance and listens on localhost only.
DATABASE_URL="postgresql://shopsmart_user:CHANGE_ME_LONG_RANDOM@127.0.0.1:5432/shopsmart?schema=public"

# Express listens only on the loopback address; Caddy is the public entry point.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Same address as the site (frontend and API share one origin through Caddy).
FRONTEND_URL=https://SHOPSMART_HOST

# Caddy is one proxy hop in front of Express, so read the visitor IP from X-Forwarded-For.
TRUST_PROXY=1

# Sign-in cookie: Secure (HTTPS only) and SameSite=Lax.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Optional AI provider (server-only secret). Leave GEMINI_API_KEY empty to use the
# labelled rule-based catalog answers instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=8000
